# 将此文件复制到服务器上的 .env 文件中。请勿提交真实的 .env 文件。
# APP_ENV=production 可启用对所需机密和设置的启动验证。
APP_ENV=production

# 主机端口仅供Docker Compose使用。Nginx将公共端口:8081代理到此本地端口。
WEB_HOST_PORT=5001
# Gunicorn worker/thread counts. Start conservatively on a small personal server.
GUNICORN_WORKERS=2
GUNICORN_THREADS=4

# Required Flask secrets. Generate two different random values, for example:
# python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
JWT_SECRET_KEY=

# Flask容器使用的MySQL连接。
#当MySQL位于另一台服务器上时，请使用私有IP或DNS名称，例如10.0.0.20。
# 如果此Ubuntu主机上已安装MySQL，请仅在以下情况下使用host.docker.internal
#MySQL已配置为接受来自Docker网桥网络的连接。
# 在此处不要使用localhost：在Web容器内部，它指的是Web容器本身。
MYSQL_HOST=
MYSQL_PORT=3306
# 使用一个仅能访问qiuzhao_db的专用MySQL账户；不要使用root账户。
MYSQL_USER=qiuzhao_app
MYSQL_PASSWORD=
MYSQL_DATABASE=qiuzhao_db

# 可选的完整 SQLAlchemy URL。在使用上述 MYSQL_* 时，请将此行注释掉。
# 数据库URL=mysql+pymysql://qiuzhao_app:password@10.0.0.20:3306/qiuzhao_db?charset=utf8mb4

# QQ Mail SMTP settings for registration codes.
MAIL_SERVER=smtp.qq.com
MAIL_USE_SSL=true
MAIL_PORT=465
# Fill in the QQ email address that sends verification codes.
MAIL_USERNAME=
# Fill in the SMTP authorization code, not the QQ account password.
MAIL_PASSWORD=
# Usually the same value as MAIL_USERNAME.
MAIL_DEFAULT_SENDER=
